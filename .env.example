# ---------------------------------------------------------------------------
# Azin Asgari CRM — configuration reference (NO real values here, ever).
#
# This Perfex install does not read a .env file. Secrets live as one 0600 file
# per provider in SE_SECRET_DIR (outside the docroot), installed with
#   /home/hyundaic/bin/se-secret-install.sh <provider>   (value on stdin)
# Non-secret configuration lives in tbloptions (Perfex options) and is edited on
# the admin screens named below. This file documents every key the WhatsApp
# patient journey depends on, so a fresh host can be checked for PRESENCE.
# ---------------------------------------------------------------------------

# --- Feature flags (options; Journeys → Settings) ---------------------------
SE_JOURNEY_ENABLED_<BRAND>=0            # se_journey_enabled_<brand>   master switch
SE_JOURNEY_SANDBOX_<BRAND>=1            # se_journey_sandbox_<brand>   real sends only to test recipients
SE_JOURNEY_TEST_RECIPIENTS_<BRAND>=     # se_journey_test_recipients_<brand>  E.164 digits, comma separated
SE_JOURNEY_INTERACTIVE_<BRAND>=1        # reply buttons (0 = text fallback)
SE_JOURNEY_AUTO_START_ORGANIC_<BRAND>=0

# --- Meta / WhatsApp identifiers (options / tables; WhatsApp → Readiness) ---
META_GRAPH_VERSION=v23.0                # se_meta_graph_version
WABA_ID=                                # tblse_wa_numbers.waba_id       (1398503638806590 in production)
WA_PHONE_NUMBER_ID=                     # tblse_wa_numbers.phone_number_id (1290456080816587)
META_APP_ID=                            # 1375062474780237 (documentation only; not read by code)

# --- Secrets (file provider; NEVER commit, NEVER echo) -----------------------
META_APP_SECRET=<file: meta_app>        # X-Hub-Signature-256 signing secret (WhatsApp inherits it)
WA_APP_SECRET=<file: wa_app>            # optional dedicated WhatsApp app secret
WA_VERIFY_TOKEN=<file: wa_verify>       # webhook verification (≤ 64 chars)
WA_ACCESS_TOKEN=<file: wa_token>        # permanent system-user token: whatsapp_business_management + whatsapp_business_messaging
JOURNEY_ENCRYPTION_KEY=<file: journey_key>  # 32 random bytes, base64 — seals health answers, check-in replies, photos
JOURNEY_KEY_VERSION=k1                  # se_journey_key_version (recorded on sealed rows)

# --- Storage ------------------------------------------------------------------
SE_SECRET_DIR=/home/hyundaic/_secrets   # constant in app-config.php (0700)
SE_MEDIA_DIR=/home/hyundaic/_se_media   # inbox attachment store (se_core/se_media.php; constant, default <home>/_se_media) or R2 via crm-media
SE_JOURNEY_MEDIA_STORAGE=auto           # se_journey_media_storage: auto (R2 when the gateway is ready) | r2 | local
SE_JOURNEY_MEDIA_DIR=/home/hyundaic/_se_journey_media   # LOCAL FALLBACK for sealed journey photos: option se_journey_media_dir or this constant (0700, outside docroot)
SE_JOURNEY_PURGE_INBOX_COPY_<BRAND>=0   # drop the plain thread copy after sealing (R2 copies need the crm-media DELETE route)
SE_MEDIA_R2_URL=https://crm-media.<account>.workers.dev   # se_media_r2_url — the crm-media gateway Worker (bucket azin-media, prefix crm/)
SE_MEDIA_STORAGE=r2                     # se_media_storage — inbox attachments (voice/video/documents) to R2
R2_MEDIA_KEY=<file: r2_media_key>       # shared HMAC key = Worker secret MEDIA_KEY (never in chat, never committed)

# --- Patient links and messaging policy (options) -----------------------------
SE_JOURNEY_PUBLIC_BASE_URL=https://crm.roozbeh.com.tr   # se_journey_public_base_url (https only)
SE_JOURNEY_INTAKE_TTL_HOURS=48
SE_JOURNEY_REMINDER_HOURS=24,72
SE_JOURNEY_QUIET_HOURS=21:00-09:00
SE_JOURNEY_DAILY_CAP=3
SE_JOURNEY_URGENT_STAFF_IDS=            # on-call staff ids for urgent alerts (admins otherwise)

# --- Clinical / legal gates (options; Journeys → Settings → clinical) ---------
SE_JOURNEY_QUOTE_AMOUNT_POLICY_<BRAND>=range    # hidden | range | exact
SE_JOURNEY_PREOP_TEXT_APPROVED_<BRAND>=0
SE_JOURNEY_PREOP_INFO_URL_<BRAND>=
SE_JOURNEY_TECHNICAL_FIELDS_<BRAND>=0
SE_JOURNEY_ASK_INFECTIOUS_<BRAND>=0
SE_JOURNEY_CONSENT_BYPASS_<BRAND>=0             # admin-only emergency bypass (audited)

# --- Consent text (Consent Settings screen; option se_consent_config_<brand>) ---
# purposes: ads, marketing, health_data (REQUIRED for the intake), photo_publication (optional)
# each needs enabled=1 + TR and EN text + a version id before the journey collects health data.
